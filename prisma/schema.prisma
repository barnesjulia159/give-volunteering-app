// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

enum UserRole {
  volunteer
  Organization
  admin

  @@schema("public")
}

enum ApprovalStatus {
  pending
  approved
  rejected

  @@map("profile_approval_status")
  @@schema("public")
}

enum OpportunityStatus {
  draft
  published
  closed
  archived

  @@schema("public")
}

enum BookingStatus {
  booked
  cancelled
  waitlisted
  completed
  no_show

  @@map("booking_status")
  @@schema("public")
}

enum AttendanceStatus {
  present
  absent
  excused
  no_show

  @@map("attendance_status")
  @@schema("public")
}

enum NotificationStatus {
  queued
  sent
  failed

  @@map("notification_status")
  @@schema("public")
}

model Organization {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String   @unique @db.Uuid
  name              String
  mission_statement String
  description       String?
  contact_name      String
  contact_email     String
  contact_phone     String?
  website_url       String?
  address_line1     String?
  address_line2     String?
  city              String?
  state             String?
  zip_code          String?
  is_approved       Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  profile       Profile       @relation(fields: [user_id], references: [id])
  opportunities Opportunity[]

  @@map("organizations")
  @@schema("public")
}

model Opportunity {
  id                  String            @id @default(uuid()) @db.Uuid
  organization_id     String            @db.Uuid
  created_by          String            @db.Uuid
  title               String
  description         String
  location_name       String?
  address_line1       String?
  address_line2       String?
  city                String?
  state               String?
  zip_code            String?
  start_at            DateTime          @db.Timestamptz
  end_at              DateTime          @db.Timestamptz
  capacity            Int
  minimum_age         Int?
  accessibility_notes String?
  requirements        String?
  status              OpportunityStatus @default(draft)
  is_virtual          Boolean           @default(false)
  is_deleted          Boolean           @default(false)
  published_at        DateTime?         @db.Timestamptz
  created_at          DateTime          @default(now()) @db.Timestamptz
  updated_at          DateTime          @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organization_id], references: [id])
  bookings     Booking[]
  notifications Notification[]
  volunteerHours VolunteerHour[]

  @@map("opportunities")
  @@schema("public")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  opportunity_id String        @db.Uuid
  volunteer_id   String        @db.Uuid
  status         BookingStatus @default(booked)
  notes          String?
  booked_at      DateTime      @default(now()) @db.Timestamptz
  cancelled_at   DateTime?     @db.Timestamptz
  created_at     DateTime      @default(now()) @db.Timestamptz
  updated_at     DateTime      @updatedAt @db.Timestamptz

  opportunity Opportunity @relation(fields: [opportunity_id], references: [id])
  volunteer   Profile     @relation(fields: [volunteer_id], references: [id])
  attendanceLog AttendanceLog?
  notifications Notification[]

  @@map("bookings")
  @@schema("public")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  sender_id      String?   @db.Uuid
  recipient_id   String    @db.Uuid
  booking_id     String?   @db.Uuid
  opportunity_id String?   @db.Uuid
  type           String
  title          String
  message        String
  status         NotificationStatus @default(sent)
  read_at        DateTime? @db.Timestamptz
    archived_at    DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz

  sender      Profile?      @relation("NotificationsSent", fields: [sender_id], references: [id], onDelete: SetNull)
  recipient   Profile       @relation("NotificationsReceived", fields: [recipient_id], references: [id], onDelete: Cascade)
  booking     Booking?     @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunity_id], references: [id], onDelete: SetNull)

  @@index([recipient_id, read_at])
  @@index([sender_id, status])
  @@index([created_at])
  @@map("notifications")
  @@schema("public")
}

model AttendanceLog {
  id          String           @id @default(uuid()) @db.Uuid
  booking_id  String           @unique @db.Uuid
  recorded_by String?          @db.Uuid
  status      AttendanceStatus
  notes       String?
  check_in_at DateTime?        @db.Timestamptz
  check_out_at DateTime?       @db.Timestamptz
  recorded_at DateTime         @default(now()) @db.Timestamptz
  created_at  DateTime         @default(now()) @db.Timestamptz
  updated_at  DateTime         @updatedAt @db.Timestamptz

  booking   Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  recorder  Profile? @relation("AttendanceRecordedBy", fields: [recorded_by], references: [id], onDelete: SetNull)

  @@index([recorded_by])
  @@map("attendance_logs")
  @@schema("public")
}

model VolunteerHour {
  id             String   @id @default(uuid()) @db.Uuid
  volunteer_id   String   @db.Uuid
  opportunity_id String   @db.Uuid
  recorded_by    String   @db.Uuid
  hours          Float
  notes          String?
  recorded_at    DateTime @default(now()) @db.Timestamptz
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz

  volunteer   Profile     @relation("VolunteerHours", fields: [volunteer_id], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)
  recorder    Profile     @relation("HoursRecordedBy", fields: [recorded_by], references: [id], onDelete: Restrict)

  @@index([volunteer_id, recorded_at])
  @@index([opportunity_id, recorded_at])
  @@schema("public")
}

model user {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  @@schema("public")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("public")
}

model Profile {
  id                String         @id @default(uuid()) @db.Uuid
  role              String         @default("volunteer")
  firstName         String?        @map("first_name")
  lastName          String?        @map("last_name")
  displayName       String         @map("display_name")
  phone             String?
  city              String?
  state             String?
  zipCode           String?        @map("zip_code")
  bio               String?
  availabilityNotes String?        @map("availability_notes")

  approvalStatus    ApprovalStatus @default(pending) @map("approval_status")

  isActive           Boolean       @default(true) @map("is_active")
  skillsAndCauses    String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  organization          Organization?
  bookings              Booking[]
  sentNotifications     Notification[] @relation("NotificationsSent")
  receivedNotifications Notification[] @relation("NotificationsReceived")
  attendanceLogs        AttendanceLog[] @relation("AttendanceRecordedBy")
  volunteerHours        VolunteerHour[] @relation("VolunteerHours")
  recordedHours         VolunteerHour[] @relation("HoursRecordedBy")

  @@map("profiles")
  @@schema("public")
}
